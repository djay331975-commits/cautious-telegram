# AutoStream Commerce — environment variables
# Copy to .env and fill in real values. NEVER commit real credentials.

# Shopify Admin API access token (used by scripts/bulk_list_*.py and API webhook calls)
SHOPIFY_ACCESS_TOKEN=

# Shopify OAuth app credentials (used by /shopify/callback in apps/api)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# CJ Dropshipping API key (format: CJUserNum@api@THE_KEY) — used by CJ fulfillment webhook
CJ_API_KEY=

# SQLite database used by Prisma
DATABASE_URL=file:/home/team/.data/agent-team-1a604bf3.db
